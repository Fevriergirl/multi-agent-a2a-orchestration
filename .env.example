# deterministic runs fully offline and is the default
HAUNTED_STUDIO_PROVIDER=deterministic

# Set these only when using the OpenAI provider
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5.5
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_BASE_URL=https://api.openai.com/v1

# Set these only when using the Anthropic (Claude) provider.
# Text-only: Claude has no image-generation API, so the visual-audit
# stages are skipped and accepted work stays at conceptual_only status.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_MAX_TOKENS=4096

# Image backend for --image runs (independent of the reasoning provider).
# offline (default) renders with the built-in generative renderer, no key.
# openai renders photoreal via the OpenAI Images API (needs OPENAI_API_KEY +
# OPENAI_IMAGE_MODEL above).
HAUNTED_STUDIO_IMAGE=offline

# Optional
HAUNTED_STUDIO_HOME=.haunted-studio
HAUNTED_STUDIO_PORT=19820
