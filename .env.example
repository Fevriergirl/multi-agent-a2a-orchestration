# deterministic runs fully offline and is the default
HAUNTED_STUDIO_PROVIDER=deterministic

# Set these only when using the OpenAI provider
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5.5
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional
HAUNTED_STUDIO_HOME=.haunted-studio
HAUNTED_STUDIO_PORT=19820
